# ==============================================================================
# KICKOFF CLUB API - CONFIGURACIÓN DE ENTORNO (PLANTILLA EJEMPLO)
# ==============================================================================

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos (Parámetros Individuales)
DB_HOST=tu-host-de-neon.neon.tech
DB_PORT=5432
DB_USER=nombre_usuario
DB_PASSWORD=contrasena_segura
DB_NAME=nombre_base_datos
DB_SSL=true

# URL de Conexión Completa (Recomendado para NestJS TypeORM / Prisma / Neon Connection Pooler)
DATABASE_URL=postgresql://usuario:contrasena@tu-host-de-neon.neon.tech/nombre_base_datos?sslmode=require

# Configuración de JWT
JWT_SECRET=reemplazar_con_una_clave_aleatoria_muy_larga_y_segura
JWT_EXPIRES_IN=24h

# Configuración de APIs Externas (Sincronización con thesportsdb.com)
SPORTS_API_URL=https://www.thesportsdb.com/api/v1/json
SPORTS_API_KEY=1
